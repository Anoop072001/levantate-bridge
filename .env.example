# Copy to .env.local and fill in. Never commit .env.local.
# See the environment inventory in AGENTS.md for which phase needs which key.

# --- Circle (Phase 1) ---
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_AGENT_WALLET_ID=
CIRCLE_AGENT_WALLET_ADDRESS=
CIRCLE_RELAYER_WALLET_ID=
CIRCLE_RELAYER_WALLET_ADDRESS=
DEPLOYER_AGENT_ADDRESS=
DEPLOYER_RELAYER_ADDRESS=

# --- Arc testnet (Phase 2) ---
# Comma-separated RPC list (backend + frontend fallback). Defaults to Arc public endpoints.
# ARC_RPC_URL=https://rpc.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io
DEPLOYER_PRIVATE_KEY=
ESCROW_CONTRACT_ADDRESS=
ESCROW_DEPLOY_BLOCK=

# --- World ID (Phase 3) ---
# WORLD_DEVELOPER_API_KEY authenticates the Developer Portal management API/MCP only.
# It cannot sign rp_context or verify proofs — it is what you use to mint the RP below.
WORLD_DEVELOPER_API_KEY=
WORLD_APP_ID=
WORLD_RP_ID=
# Server-only. Returned exactly once at RP registration and unrecoverable.
WORLD_SIGNING_KEY=
WORLD_ID_ACTION=
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# Optional — proof download links in agent/API responses (defaults to NEXT_PUBLIC_BACKEND_URL)
# PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_RP_ID=

# RainbowKit / WalletConnect (frontend). Public identifier, not a secret.
# Create a free project at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Supabase (Phase 4) ---
# Service role key is server-only. Never expose it to the frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- The Graph (Phase 5) ---
GRAPH_AUTH_DEPLOY_KEY=
# Studio deploy key only — create a separate query key at thegraph.com/studio → API Keys.
GRAPH_QUERY_API_KEY=
GRAPH_SUBGRAPH_ID=Fnr7E8tC1HbD1bvdAsTXMwe5R5kZdx98pH1bhmcWWGeL
# Current Network deployment (reference only; gateway queries use GRAPH_SUBGRAPH_ID).
# GRAPH_DEPLOYMENT_ID=QmaVmi77QATkuT8u3C2X1M96iUFA1ivyTRFeSFdhcHQxk6
# Optional gateway URL override (Bearer auth via GRAPH_QUERY_API_KEY):
# SUBGRAPH_QUERY_URL=https://gateway.thegraph.com/api/subgraphs/id/Fnr7E8tC1HbD1bvdAsTXMwe5R5kZdx98pH1bhmcWWGeL

# --- Agent proof evaluation (Phase 7, D2) — pick one ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Winner selection after bid deadline (default on). Set false to disable.
# AGENT_WINNER_LOOP=false
# Proof review runs automatically when a worker submits — not on a timer.
# POST /api/agent/run-once re-processes any stuck Submitted tasks manually.
